{
  "name": "milktrack-agent-app",
  "main": "expo-router/entry",
  "version": "0.1.0",
  "dependencies": {
    "@react-native-community/netinfo": "12.0.1",
    "@tanstack/react-query": "5.101.2",
    "expo": "~57.0.8",
    "expo-constants": "~57.0.7",
    "expo-linking": "~57.0.4",
    "expo-router": "~57.0.8",
    "expo-secure-store": "57.0.1",
    "expo-splash-screen": "~57.0.5",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.1",
    "openapi-fetch": "0.17.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.0",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "~0.21.0"
  },
  "devDependencies": {
    "@react-native/jest-preset": "0.86.0",
    "@testing-library/react-native": "14.0.1",
    "@types/jest": "29.5.14",
    "@types/react": "~19.2.2",
    "eslint": "9.39.5",
    "eslint-config-expo": "~57.0.0",
    "expo-doctor": "1.20.1",
    "jest": "~29.7.0",
    "jest-expo": "~57.0.2",
    "openapi-typescript": "7.13.0",
    "test-renderer": "1.2.0",
    "typescript": "6.0.3"
  },
  "scripts": {
    "start": "expo start --lan",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "doctor": "expo-doctor",
    "test": "jest --runInBand",
    "test:watch": "jest --watch",
    "api:generate": "openapi-typescript openapi/openapi.json -o src/api/schema.d.ts",
    "api:check": "node scripts/verify-openapi.mjs && openapi-typescript openapi/openapi.json -o /tmp/schema.d.ts && cmp -s /tmp/schema.d.ts src/api/schema.d.ts",
    "export": "expo export --platform all --output-dir dist",
    "verify": "npm run doctor && npm run lint && npm run typecheck && npm test && npm run api:check && npm run export"
  },
  "private": true
}
